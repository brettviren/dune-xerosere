export XEROSERE_TOP="$PWD"
export XEROSERE_ENVS="$XEROSERE_TOP/extern/envs"
export XEROSERE_INSTALLS="$XEROSERE_TOP/installs/envs"

PATH_add $PWD/extern/spack/bin

export SPACK_USER_CACHE_PATH="$PWD/extern/cache"
export SPACK_USER_CONFIG_PATH="$PWD/extern/scopes/user"
export SPACK_SYSTEM_CONFIG_PATH="$PWD/extern/scopes/system"

# warning: local to me for now
export SPACK_BUILDCACHE=/nfs/data/1/bviren/spack-cache

# warning: local to wcgpu
# PATH_add /usr/local/cuda-12.5/bin


path_add LD_LIBRARY_PATH /usr/lib/x86_64-linux-gnu/nvidia/current/

export WIRECELL_PATH=$PWD/devel/wire-cell-toolkit/cfg:$PWD/reference/wire-cell-data:$PWD/reference/dunereco/dunereco/DUNEWireCell/protodunevd

PATH_add $PWD/devel/wire-cell-toolkit/test/bats/bin
export BATS_LIB_PATH=$PWD/devel/wire-cell-toolkit/test

# Run-time environment (the extern dependency view + a specific env/variant's
# install prefix + PHLEX_PLUGIN_PATH) is NOT set here; it lives per-variant in a
# direnv "rundir" under runs/envs/<env>/.  `cd` into one to run that env's
# binaries -- it inherits this file via direnv's source_up.  Manage rundirs with:
#     xerosere dev variant runs        # (re)generate the base env + all variants
