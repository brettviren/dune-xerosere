# myrepos / mr configuration for xerosere

# Most likely you must list the path to this file in your ~/.mrtrust file.

[extern/spack]
checkout = git clone --branch v1.2.0 --depth=2 'https://github.com/spack/spack.git' 'spack'
skip = [ "$MR_ACTION" = "push" ] || [ "$MR_ACTION" = "commit" ]

[devel/arrow-hdf]
checkout = git clone 'git@github.com:brettviren/arrow-hdf.git' 'arrow-hdf'

[devel/boost-config]
checkout = git clone 'git@github.com:brettviren/boost-config.git' 'boost-config'

[devel/phlex-arrow-common]
checkout = git clone 'git@github.com:brettviren/phlex-arrow-common.git' 'phlex-arrow-common'

[devel/wire-cell-arrow]
checkout = git clone 'git@github.com:WireCell/wire-cell-arrow.git' 'wire-cell-arrow'

[devel/wire-cell-phlex]
checkout = git clone 'git@github.com:brettviren/wire-cell-phlex.git' 'wire-cell-phlex'

[devel/wire-cell-phlex-arrow]
checkout = git clone 'git@github.com:brettviren/wire-cell-phlex-arrow.git' 'wire-cell-phlex-arrow'

[devel/dune-config]
checkout = git clone 'git@github.com:brettviren/dune-config.git' 'dune-config'

[devel/dune-daq-arrow-frame-hdf]
checkout = git clone 'git@github.com:brettviren/dune-daq-arrow-frame-hdf.git' 'dune-daq-arrow-frame-hdf'

[devel/dune-daq-codec]
checkout = git clone 'git@github.com:brettviren/dune-daq-codec.git' 'dune-daq-codec'

[devel/dune-daq-hdf]
checkout = git clone 'git@github.com:brettviren/dune-daq-hdf.git' 'dune-daq-hdf'

[devel/dune-daq-types]
checkout = git clone 'git@github.com:brettviren/dune-daq-types.git' 'dune-daq-types'

[devel/phlex-arrow-hdf]
checkout = git clone 'git@github.com:brettviren/phlex-arrow-hdf.git' 'phlex-arrow-hdf'

[devel/phlexed]
checkout = git clone 'git@github.com:brettviren/phlexed.git' 'phlexed'

[devel/hepmc-phlex]
checkout = git clone 'git@github.com:brettviren/hepmc-phlex.git' 'hepmc-phlex'

[devel/edep-sim-phlex]
checkout = git clone 'git@github.com:brettviren/edep-sim-phlex.git' 'edep-sim-phlex'

[devel/edep-phlex]
checkout = git clone 'git@github.com:brettviren/edep-phlex.git' 'edep-phlex'

[devel/edep-simphony-plugin]
checkout = git clone 'git@github.com:brettviren/edep-simphony-plugin' 'edep-simphony-plugin'

[devel/edep-sim]
checkout = git clone 'git@github.com:clarkmcgrew/edep-sim.git' 'edep-sim'

[devel/wire-cell-toolkit]
checkout = git clone 'git@github.com:wirecell/wire-cell-toolkit.git' 'wire-cell-toolkit'

# Spack package recipe repos (referenced by extern/envs/*/spack.yaml repos:).
# wire-cell-spack must have highest repo precedence (listed first in spack.yaml)
# to override commonly-named packages from the other repos and builtin.
[extern/repos/wire-cell-spack]
checkout = git clone 'git@github.com:wirecell/wire-cell-spack.git' 'wire-cell-spack'

[extern/repos/fnal_art]
checkout = git clone 'https://github.com/FNALssi/fnal_art.git' 'fnal_art'
skip = [ "$MR_ACTION" = "push" ] || [ "$MR_ACTION" = "commit" ]

[extern/repos/phlex-spack-recipes]
checkout = git clone 'https://github.com/Framework-R-D/phlex-spack-recipes.git' 'phlex-spack-recipes'
# skip = [ "$MR_ACTION" = "push" ] || [ "$MR_ACTION" = "commit" ]

[extern/repos/edep-simphony-spack]
checkout = git clone 'git@github.com:WireCell/edep-simphony-spack.git' 'edep-simphony-spack'

[extern/repos/dune-tdm-spack]
checkout = git clone 'git@github.com:brettviren/dune-tdm-spack.git' 'dune-tdm-spack'


[reference/phlex]
checkout = git clone 'https://github.com/Framework-R-D/phlex.git' 'phlex'


[devel/hep-config]
checkout = git clone 'git@github.com:brettviren/hep-config.git' 'hep-config'

[devel/hep-units]
checkout = git clone 'git@github.com:brettviren/hep-units.git' 'hep-units'

[devel/edep-arrow]
checkout = git clone 'git@github.com:brettviren/edep-arrow.git' 'edep-arrow'

[devel/phlex-config]
checkout = git clone 'git@github.com:brettviren/phlex-config.git' 'phlex-config'

[python/adove]
checkout = git clone 'git@github.com:brettviren/adove.git' 'adove'

[python/graphlex]
checkout = git clone 'git@github.com:brettviren/graphlex.git' 'graphlex'

[python/teepeesee]
checkout = git clone 'git@github.com:brettviren/teepeesee.git' 'teepeesee'

[python/wct-metrics]
checkout = git clone 'git@github.com:brettviren/wct-metrics.git' 'wct-metrics'

[python/xerosere]
checkout = git clone 'git@github.com:brettviren/xerosere.git' 'xerosere'

[devel/phlex-ntuple]
checkout = git clone 'git@github.com:brettviren/phlex-ntuple.git' 'phlex-ntuple'

[devel/arrow-ntuple]
checkout = git clone 'git@github.com:brettviren/arrow-ntuple.git' 'arrow-ntuple'
